{
  "name": "lap-tracker",
  "version": "0.1",
  "description": "Track laps using QR codes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && $npm_execpath run build:pwa",
    "build:pwa": "tsx build/generate-service-worker.ts",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy"
  },
  "keywords": [
    "qr code",
    "lap tracker",
    "pwa"
  ],
  "author": "Stephen Smithwick",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@types/node": "^26.4.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vite-ssr-components": "^0.6.1",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/oauth-providers": "^0.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.5",
    "solid-js": "^1.9.15"
  }
}
